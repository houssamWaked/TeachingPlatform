# Flutter apps serve the packaged React UI locally and proxy /api requests to
# this backend origin. Do not put Supabase service-role or Bunny secrets here.
PLATFORM_API_ORIGIN=https://teaching-platform-one.vercel.app

# Flutter does not load .env files automatically. Pass the value at build/run:
# flutter run --dart-define=PLATFORM_API_ORIGIN=https://teaching-platform-one.vercel.app
