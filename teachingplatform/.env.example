# =============================================================
# LESSON PORTAL â€” ENVIRONMENT VARIABLES
# Copy this file to .env.local and replace every placeholder.
# Never commit .env.local or real secret values.
# =============================================================

# FRONTEND (Vite)
# Local Vite development only. Production uses the same-origin /api rewrite in vercel.json.
VITE_API_BASE_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/api

# SUPABASE EDGE FUNCTION
# Find these in Supabase Dashboard â†’ Project Settings â†’ API.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# BUNNY STREAM (Supabase Edge Function secrets only)
# Library ID and API key are in Stream → your library → API.
# Signing key is the library token authentication security key.
BUNNY_STREAM_LIBRARY_ID=YOUR_BUNNY_STREAM_LIBRARY_ID
BUNNY_STREAM_CDN_HOST=YOUR_LIBRARY_CDN_HOST
BUNNY_STREAM_API_KEY=YOUR_BUNNY_STREAM_LIBRARY_API_KEY
BUNNY_STREAM_SIGNING_KEY=YOUR_BUNNY_STREAM_TOKEN_SECURITY_KEY

# TEACHER ADMIN
# Choose a long, unique password (recommended: 20+ characters).
ADMIN_PASSWORD=CHANGE_THIS_TO_A_LONG_SECURE_PASSWORD

# CORS / FRONTEND ORIGIN
# Use only the originâ€”no trailing slash or route.
# Local example: http://localhost:5173
# Production example: https://lessons.example.com
ALLOWED_ORIGIN=http://localhost:5173
